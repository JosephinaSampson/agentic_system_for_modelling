{
  "permissions": {
    "allow": [],
    "deny": ["SendMessage"]
  },
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/record_specialist_invocation.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/stage_gate_guard.py\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/data_orchestrator_guard.py\" || exit 2"
          }
        ]
      }
    ]
  }
}
